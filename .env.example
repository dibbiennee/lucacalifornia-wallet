# ---------------------------------------------------------------------------
# Identificativi Apple. Non sono segreti, ma non stanno nel codice.
# ---------------------------------------------------------------------------
# Il Pass Type ID registrato sul portale Apple.
PASS_TYPE_IDENTIFIER=pass.it.satoshiweb.lucacalifornia
# Il Team ID: developer.apple.com > Account > Membership details.
APPLE_TEAM_IDENTIFIER=CYZ7XKRGWR

# ---------------------------------------------------------------------------
# Certificati. In locale NON servono: bastano i file dentro certs/.
# Su Vercel servono qui, ognuno è il PEM convertito in base64 su una riga sola:
#   base64 -i certs/signerCert.pem | pbcopy
# ---------------------------------------------------------------------------
PASS_SIGNER_CERT_BASE64=
PASS_SIGNER_KEY_BASE64=
PASS_WWDR_BASE64=
# La password scelta quando e' nata la chiave (protegge signerKey.pem).
PASS_SIGNER_KEY_PASSPHRASE=

# ---------------------------------------------------------------------------
# Chiave con cui si cifrano i token dentro il biglietto. Una frase lunga almeno 16
# caratteri, o meglio 32 byte casuali:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se cambia, i biglietti già consegnati smettono di aprirsi.
# ---------------------------------------------------------------------------
SEGRETO_BIGLIETTO=

# ---------------------------------------------------------------------------
# Password del pannello di Luca. Almeno 8 caratteri.
# Cambiandola scadono da sole tutte le sessioni aperte.
# ---------------------------------------------------------------------------
PANNELLO_PASSWORD=

# ---------------------------------------------------------------------------
# Chiave con cui si firmano le sessioni del pannello (Luca e PR).
# OBBLIGATORIA in produzione: senza, il pannello si ferma con un errore di
# configurazione. Almeno 32 caratteri casuali:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In locale non serve. Se cambia, escono tutti (Luca e PR).
# ---------------------------------------------------------------------------
SEGRETO_SESSIONE=

# ---------------------------------------------------------------------------
# Database (Neon, Postgres). OBBLIGATORIA: senza, il sito non salva le richieste.
# La stringa di connessione del database di PRODUZIONE va solo su Vercel.
# Non usare mai quella di un branch di prova, e non scriverla in questo file.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Notifiche push a Luca. La chiave pubblica sta nel codice (src/lib/push.ts);
# questa è la sua metà privata, un SEGRETO. Senza, la richiesta si salva lo
# stesso ma a Luca non arriva nessun avviso.
# ---------------------------------------------------------------------------
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Il sito pubblico.
#  - SITO_PUBBLICO=1 toglie il "noindex" dalle pagine e apre robots.txt. Va
#    messo solo il giorno del lancio, insieme.
#  - INDIRIZZO_SITO è il dominio definitivo, con https e senza barra finale
#    (es. https://www.lucacalifornia.it). Lo usano i link dei PR (/pr/<codice>),
#    le anteprime di condivisione e il messaggio di WhatsApp.
# ---------------------------------------------------------------------------
SITO_PUBBLICO=
INDIRIZZO_SITO=
